TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: topic id for supergroups with topics
TELEGRAM_THREAD_ID=
# Optional: path to an already installed Chromium/Chrome (e.g. /usr/bin/chromium)
# Use it when "playwright install chromium" is not supported on your platform
CHROMIUM_EXECUTABLE_PATH=
# Optional: set to debug to log every step of each check (default: only events and errors)
LOG_LEVEL=
